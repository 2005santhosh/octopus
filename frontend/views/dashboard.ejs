                            </div>
                            <div class="content-item">
                                <div class="content-icon">
                                    <i class="fab fa-youtube"></i>
                                </div>
                                <div class="content-details">
                                    <div class="content-title">How to Use AI for Content Creation</div>
                                    <div class="content-meta">Video • Yesterday</div>
                                </div>
                                <div class="content-status published">Published</div>
                            </div>
                            <div class="content-item">
                                <div class="content-icon">
                                    <i class="fab fa-twitter"></i>
                                </div>
                                <div class="content-details">
                                    <div class="content-title">Weekly Content Roundup</div>
                                    <div class="content-meta">Social Media • 2 days ago</div>
                                </div>
                                <div class="content-status published">Published</div>
                            </div>
                            <div class="content-item">
                                <div class="content-icon">
                                    <i class="fas fa-file-alt"></i>
                                </div>
                                <div class="content-details">
                                    <div class="content-title">The Future of AI in Marketing</div>
                                    <div class="content-meta">Blog Post • 3 days ago</div>
                                </div>
                                <div class="content-status draft">Draft</div>
                            </div>
                            <div class="content-item">
                                <div class="content-icon">
                                    <i class="fas fa-envelope"></i>
                                </div>
                                <div class="content-details">
                                    <div class="content-title">Monthly Newsletter - June</div>
                                    <div class="content-meta">Email • Scheduled</div>
                                </div>
                                <div class="content-status scheduled">Scheduled</div>
                            </div>
                        </div>
                    </div>

                    <div class="section-card">
                        <div class="section-header">
                            <div class="section-title">Quick Actions</div>
                        </div>
                        <div class="quick-actions">
                            <a href="/content" class="quick-action" data-requires-credits>
                                <i class="fas fa-plus"></i>
                                <span>Create Content</span>
                            </a>
                            <a href="/analytics" class="quick-action">
                                <i class="fas fa-chart-bar"></i>
                                <span>View Reports</span>
                            </a>
                            <a href="/calendar" class="quick-action">
                                <i class="fas fa-calendar-plus"></i>
                                <span>Track Post</span>
                            </a>
                            <a href="/social-accounts" class="quick-action">
                                <i class="fas fa-share-alt"></i>
                                <span>Manage Social</span>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="section-card">
                    <div class="section-header">
                        <div class="section-title">Content Performance</div>
                        <a href="/analytics" class="section-action">View Report</a>
                    </div>
                    <div class="chart-container">
                        <canvas id="contentPerformanceChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <button class="create-button" data-requires-credits>
        <i class="fas fa-plus"></i>
    </button>

    <script>
        function showMessage(text, type) {
            const message = document.createElement('div');
            message.className = `notification ${type}`;
            message.textContent = text;
            document.body.appendChild(message);
            setTimeout(() => message.remove(), 3000);
        }

        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.querySelector('.sidebar');
            const logo = document.querySelector('.sidebar-logo');
            let credits = localStorage.getItem('credits') ? parseInt(localStorage.getItem('credits')) : 5;
            if (isNaN(credits)) credits = 5;
            const maxCredits = 5;

            let connectedAccounts;
            try {
                connectedAccounts = <%- JSON.stringify(connectedAccounts || {
                    facebook: false,
                    twitter: false,
                    instagram: false,
                    linkedin: false,
                    youtube: false
                }) %>;
            } catch (e) {
                console.error('Error parsing connectedAccounts:', e);
                connectedAccounts = {
                    facebook: false,
                    twitter: false,
                    instagram: false,
                    linkedin: false,
                    youtube: false
                };
            }

            const userName = '<%= user.name || "Guest" %>';

            function updateCreditDisplay() {
                const creditsText = document.getElementById('creditsText');
                const creditNumber = document.getElementById('creditNumber');
                const creditCount = document.getElementById('creditCount');
                const creditBar = document.getElementById('creditBar');

                if (creditsText && creditNumber && creditCount && creditBar) {
                    creditsText.textContent = `${credits}/${maxCredits} Credits`;
                    creditNumber.textContent = `${credits}/${maxCredits}`;
                    creditCount.textContent = credits;
                    const percentage = (credits / maxCredits) * 100;
                    creditBar.style.width = `${percentage}%`;
                } else {
                    console.error('Credit display elements not found');
                }
            }

            function useCredit() {
                if (credits > 0) {
                    credits--;
                    localStorage.setItem('credits', credits);
                    updateCreditDisplay();
                    return true;
                }
                return false;
            }

            function updateSocialList() {
                const socialList = document.getElementById('socialList');
                if (!socialList) {
                    console.error('socialList element not found');
                    showMessage('Error loading social accounts section.', 'error');
                    return;
                }
                socialList.innerHTML = '';

                const platforms = [
                    { name: 'Facebook', icon: 'facebook-f', class: 'facebook', connected: connectedAccounts.facebook, status: `Connected as ${userName}` },
                    { name: 'Twitter', icon: 'twitter', class: 'twitter', connected: connectedAccounts.twitter, status: `Connected as @${userName.replace(/\s+/g, '').toLowerCase()}` },
                    { name: 'Instagram', icon: 'instagram', class: 'instagram', connected: connectedAccounts.instagram, status: `Connected as @${userName.replace(/\s+/g, '').toLowerCase()}` },
                    { name: 'LinkedIn', icon: 'linkedin-in', class: 'linkedin', connected: connectedAccounts.linkedin, status: `Connected as ${userName}` },
                    { name: 'YouTube', icon: 'youtube', class: 'youtube', connected: connectedAccounts.youtube, status: `Connected as ${userName}'s Channel` }
                ];

                const hasConnectedAccounts = platforms.some(platform => platform.connected);

                if (hasConnectedAccounts) {
                    platforms.forEach(platform => {
                        if (platform.connected) {
                            socialList.innerHTML += `
                                <div class="social-item">
                                    <div class="social-icon ${platform.class}">
                                        <i class="fab fa-${platform.icon}"></i>
                                    </div>
                                    <div class="social-details">
                                        <div class="social-name">${platform.name}</div>
                                        <div class="social-status">${platform.status}</div>
                                    </div>
                                    <button class="social-action disconnect" data-platform="${platform.name.toLowerCase()}">Disconnect</button>
                                </div>
                            `;
                        }
                    });
                }

                socialList.innerHTML += `
                    <a href="/social-accounts" class="add-social" id="addSocialButton">
                        <div>
                            <i class="fas fa-plus"></i>
                            <div>Add Account</div>
                        </div>
                    </a>
                `;

                attachDisconnectListeners();
            }

            function attachDisconnectListeners() {
                document.querySelectorAll('.social-action.disconnect').forEach(button => {
                    button.addEventListener('click', async function() {
                        const platform = this.getAttribute('data-platform');
                        try {
                            const response = await fetch('/social-accounts/disconnect', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ platform })
                            });
                            if (response.ok) {
                                showMessage(`${platform.charAt(0).toUpperCase() + platform.slice(1)} disconnected successfully!`, 'success');
                                connectedAccounts[platform] = false;
                                updateSocialList();
                            } else {
                                const errorData = await response.json();
                                showMessage(`Error disconnecting ${platform}: ${errorData.message || 'Unknown error'}`, 'error');
                            }
                        } catch (error) {
                            showMessage(`Error disconnecting ${platform}: ${error.message}`, 'error');
                        }
                    });
                });
            }

            const ctx = document.getElementById('contentPerformanceChart')?.getContext('2d');
            if (ctx) {
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{
                            label: 'Content Performance',
                            data: [70, 85, 60, 90, 75, 95, 80],
                            backgroundColor: '#0969da',
                            borderColor: '#0750a5',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: 'Performance Score'
                                }
                            },
                            x: {
                                title: {
                                    display: true,
                                    text: 'Day'
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return `Score: ${context.parsed.y}`;
                                    }
                                }
                            }
                        }
                    }
                });
            } else {
                console.warn('Chart canvas not found');
            }

            updateSocialList();
            updateCreditDisplay();

            if (logo && sidebar) {
                logo.addEventListener('click', function() {
                    sidebar.classList.toggle('active');
                });
            } else {
                console.warn('Sidebar or logo element not found');
            }

            document.querySelectorAll('.menu-item').forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    const href = this.getAttribute('href');
                    const actionText = this.querySelector('span').textContent;
                    showMessage(`Navigating to ${actionText}...`, 'success');
                    setTimeout(() => window.location.href = href, 1000);
                });
            });

            document.querySelectorAll('.quick-action').forEach(action => {
                action.addEventListener('click', function(e) {
                    e.preventDefault();
                    const href = this.getAttribute('href');
                    const actionText = this.querySelector('span').textContent;

                    if (this.hasAttribute('data-requires-credits')) {
                        if (credits > 0) {
                            if (useCredit()) {
                                showMessage(`Opening ${actionText}...`, 'success');
                                setTimeout(() => window.location.href = href, 1000);
                            }
                        } else {
                            showMessage('No credits left. Please upgrade to premium subscription.', 'error');
                            setTimeout(() => window.location.href = '/pricing', 2000);
                        }
                    } else {
                        showMessage(`Opening ${actionText}...`, 'success');
                        setTimeout(() => window.location.href = href, 1000);
                    }
                });
            });

            const createButton = document.querySelector('.create-button');
            if (createButton) {
                createButton.addEventListener('click', function() {
                    if (credits > 0) {
                        if (useCredit()) {
                            showMessage('Opening content creation tools...', 'success');
                        }
                    } else {
                        showMessage('No credits left. Please upgrade to premium subscription.', 'error');
                        setTimeout(() => window.location.href = '/pricing', 2000);
                    }
                });
            }

            const notificationBtn = document.querySelector('.notification-btn');
            if (notificationBtn) {
                notificationBtn.addEventListener('click', function() {
                    showMessage('Opening notifications...', 'success');
                });
            }

            const buyCreditsBtn = document.querySelector('.buy-credits');
            if (buyCreditsBtn) {
                buyCreditsBtn.addEventListener('click', function() {
                    showMessage('Redirecting to pricing page...', 'success');
                    setTimeout(() => window.location.href = '/pricing', 1000);
                });
            }
        });

        window.fbAsyncInit = function() {
            FB.init({
                appId: '{your-app-id}',
                cookie: true,
                xfbml: true,
                version: '{api-version}'
            });
            FB.AppEvents.logPageView();
        };

        (function(d, s, id) {
            var js, fjs = d.getElementsByTagName(s)[0];
            if (d.getElementById(id)) { return; }
            js = d.createElement(s); js.id = id;
            js.src = "https://connect.facebook.net/en_US/sdk.js";
            fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));
    </script>
</body>
</html>